{
  "name": "prd-pipeline",
  "version": "0.1.0",
  "description": "MCP Server for PRD (Product Requirements Document) workflow — discussion, generation, and publishing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prd-pipeline": "dist/index.js"
  },
  "scripts": {
