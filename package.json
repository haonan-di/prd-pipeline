{
  "name": "prd-pipeline",
  "version": "0.2.0",
  "description": "MCP Server for PRD (Product Requirements Document) workflow — discussion, generation, and publishing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prd-pipeline": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "check:paths": "node scripts/check-paths.mjs",
    "check:presets": "node scripts/check-presets.mjs",
    "check:diagram": "node scripts/check-diagram.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mcp",
    "prd",
    "product-management",
    "documentation"
  ],
  "license": "Apache-2.0"
}
